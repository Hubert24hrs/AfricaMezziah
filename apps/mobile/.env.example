# API
EXPO_PUBLIC_API_BASE_URL=https://api.africamezziah.com/v1
EXPO_PUBLIC_API_TIMEOUT=30000

# Security
EXPO_PUBLIC_CLIENT_SECRET=your_hmac_client_secret_here
EXPO_PUBLIC_SSL_PIN_HASH=sha256/your_cert_hash_here

# Payments
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_key
EXPO_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_your_flutterwave_key
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_key

# Firebase
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=africamezziah.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=africamezziah
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=africamezziah.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry
EXPO_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# Maps
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key

# App
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_VERSION=1.0.0
