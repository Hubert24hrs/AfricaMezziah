# API
REACT_NATIVE_API_BASE_URL=https://api.africamezziah.com
REACT_NATIVE_WS_URL=wss://api.africamezziah.com

# Security
REACT_NATIVE_HMAC_SECRET=your_hmac_client_secret_here
REACT_NATIVE_SSL_CERT_HASH=sha256_fingerprint_of_your_cert

# Firebase
REACT_NATIVE_FIREBASE_PROJECT_ID=africa-mezziah

# Payments
REACT_NATIVE_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
REACT_NATIVE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxx
REACT_NATIVE_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx

# Sentry
REACT_NATIVE_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxx@o0.ingest.sentry.io/0

# EAS
EAS_PROJECT_ID=your_eas_project_id_here

# Feature Flags
REACT_NATIVE_ENABLE_3D_VIEWER=true
REACT_NATIVE_ENABLE_LIVE_SHOPPING=true
REACT_NATIVE_ENABLE_AI_ASSISTANT=true
